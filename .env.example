# BlockLens configuration. Copy to .env and fill in what you need; every
# variable is optional and the defaults (in backend/blocklens/config.py and
# docker-compose.yml) run the whole stack with no keys at all. No value
# below is a secret that ships with the repository.

# ---- docker compose ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# host port for the web app (default 8080)
WEB_PORT=
# 1 = run the live launch scorer; 0 = serve only (a UI demo that does not poll the chain)
BLOCKLENS_LIVE=

# ---- API: store and chain ----
# set by compose; for a local run, e.g. postgresql+psycopg://blocklens@127.0.0.1:5433/blocklens
DATABASE_URL=
# used by the backend test suite only (default: DATABASE_URL with _test appended)
TEST_DATABASE_URL=
CHAIN=
BLOCK_SECONDS=
FEATURE_WINDOW_HOURS=
LOG_LEVEL=
# origins allowed to call the API from a browser: comma-separated, or * (default)
CORS_ORIGINS=

# ---- API: keyless RPC ----
RPC_URL=
RPC_LOG_SPAN=
RPC_FALLBACK_URL=
RPC_FALLBACK_LOG_SPAN=
RPC_PER_SEC=
MAX_CALLS_PER_RUN=

# ---- API: market sources served to the front end (Phase 7) ----
DEXSCREENER_URL=
DEXSCREENER_PER_MIN=
GECKOTERMINAL_URL=
GECKOTERMINAL_PER_MIN=
GOPLUS_URL=
GOPLUS_PER_MIN=
TRENDING_TTL_S=
PRICES_TTL_S=
HOLDERS_TTL_S=
MARKET_TTL_S=
SCREENER_MAX_AGE_S=
UPSTREAM_TIMEOUT_S=
UPSTREAM_MAX_CALLS_PER_DAY=

# ---- API: optional paid sources (off unless set) ----
ALCHEMY_API_KEY=
ALCHEMY_PER_SEC=
MONTHLY_CU_CEILING=
CU_GET_ASSET_TRANSFERS=
CU_GET_LOGS=
# X is descoped (SCOPE.md); these stay unset
X_BEARER_TOKEN=
X_ENABLED=
X_POST_BUDGET=
X_CACHE_DIR=

# ---- API: alerts (off unless both are set) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MAX_RISK=

# ---- front end (read at build time) ----
# the API's origin; empty = same origin (the dev proxy, or nginx in the container)
VITE_API_URL=
VITE_API_TIMEOUT_MS=
# per-screen live switch: set to 0 to show that screen's sample data
VITE_LIVE_TRENDING=
VITE_LIVE_PROJECT=
VITE_LIVE_SCREENER=
VITE_LIVE_RISK=
VITE_LIVE_LAUNCHES=
